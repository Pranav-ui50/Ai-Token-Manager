# ===========================================
# Environment Configuration Example
# ===========================================
# Copy this file to .env and update values for your environment
#
# 🔒 SECURITY NOTE:
# For sensitive credentials (passwords, API keys, secrets), you can use
# encrypted values instead of plaintext. Run the encryption tool:
#
#   node src/scripts/encrypt-credential.js
#
# Then use *_ENCRYPTED versions of variables. The system will automatically
# decrypt them when needed.
#
# Example:
#   SMTP_PASSWORD_ENCRYPTED="base64-encoded-encrypted-value"
#   # Instead of:
#   # SMTP_PASSWORD="your-plain-password"  # ❌ NOT RECOMMENDED
# ===========================================

# ===========================================
# Application Settings
# ===========================================
NODE_ENV=development
PORT=5000
APP_NAME="API Token Manager"
API_VERSION=v1

# ===========================================
# Encryption Key (REQUIRED)
# ===========================================
# Generate a secure encryption key for production
# Option 1: 64-character hex string (recommended)
#   openssl rand -hex 32
# Option 2: Any string (will be hashed to 32 bytes)
#   openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-any-length-or-64-hex-chars

# ===========================================
# Database Configuration
# ===========================================
# MongoDB connection string
# IMPORTANT: For MongoDB Atlas, ensure your IP is whitelisted
MONGODB_URI=mongodb://localhost:27017/api-token-manager
MONGODB_DB_NAME=api-token-manager

# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?appName=Cluster
# MONGODB_DB_NAME=api-token-manager

# ===========================================
# Redis Configuration (Optional)
# ===========================================
# Leave empty to run without Redis (not recommended for production)
# Set SKIP_REDIS=true to explicitly disable Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PASSWORD_ENCRYPTED=
SKIP_REDIS=false

# ===========================================
# Authentication Settings
# ===========================================
# Use encrypted versions in production: JWT_SECRET_ENCRYPTED
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_SECRET_ENCRYPTED=
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_SECRET_ENCRYPTED=
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Session Configuration
# ===========================================
SESSION_SECRET=your-session-secret-change-in-production
SESSION_SECRET_ENCRYPTED=
SESSION_MAX_AGE=86400000

# ===========================================
# Two-Factor Authentication
# ===========================================
OTP_ISSUER=API Token Manager

# ===========================================
# Password Settings
# ===========================================
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_EXPIRES=3600000

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ===========================================
# Email Configuration (SMTP)
# ===========================================
# SMTP server settings - Required for password reset and email verification

# For Gmail (recommended for development):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# Note: Enable 2FA and create an App Password at https://myaccount.google.com/apppasswords

# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# For Mailtrap (development only):
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_ENCRYPTED=
SMTP_REJECT_UNAUTHORIZED=true

# Email sender information
EMAIL_FROM_NAME=API Token Manager
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# ===========================================
# Payment Gateway - Stripe
# ===========================================
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use encrypted versions in production: STRIPE_SECRET_KEY_ENCRYPTED

STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_SECRET_KEY_ENCRYPTED=
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_WEBHOOK_SECRET_ENCRYPTED=

# Stripe Price IDs (create products in Stripe dashboard)
STRIPE_STARTER_PRICE_ID=price_starter_monthly
STRIPE_PROFESSIONAL_PRICE_ID=price_professional_monthly

# ===========================================
# Payment Gateway - Razorpay
# ===========================================
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use encrypted versions in production: RAZORPAY_KEY_SECRET_ENCRYPTED

RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_KEY_SECRET_ENCRYPTED=
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_WEBHOOK_SECRET_ENCRYPTED=

# Razorpay Plan IDs
RAZORPAY_STARTER_PLAN_ID=plan_starter
RAZORPAY_PROFESSIONAL_PLAN_ID=plan_professional

# ===========================================
# AI Provider API Keys
# ===========================================
# Use encrypted versions in production

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_KEY_ENCRYPTED=

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_API_KEY_ENCRYPTED=

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_KEY_ENCRYPTED=

# Google AI API Key
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_API_KEY_ENCRYPTED=

# Mistral AI API Key
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_API_KEY_ENCRYPTED=

# ===========================================
# Frontend URLs
# ===========================================
# Production: Set to your frontend domain
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug

# ===========================================
# Security (CORS)
# ===========================================
# Production: Set to your frontend domain only (no localhost)
CORS_ORIGIN=http://localhost:5173
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Organization-ID

# ===========================================
# Feature Flags
# ===========================================
ENABLE_2FA=true
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RESET=true

# ===========================================
# WebSocket Configuration
# ===========================================
# For real-time features (Socket.IO)
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/socket.io

# ===========================================
# Production Checklist
# ===========================================
# Before deploying to production, ensure:
# ☐ NODE_ENV=production
# ☐ All *_ENCRYPTED variables are set instead of plaintext
# ☐ JWT_SECRET is at least 32 characters
# ☐ ENCRYPTION_KEY is set and secure
# ☐ Database credentials are encrypted
# ☐ Payment gateway credentials are encrypted
# ☐ AI provider API keys are encrypted
# ☐ SMTP credentials are encrypted
# ☐ Webhook secrets are set for payment gateways
# ☐ CORS_ORIGIN is set to your frontend URL only
# ☐ Rate limiting is enabled
# ☐ Run: node src/scripts/security-check.js