# Production Environment Configuration
# Copy this to .env.production and fill in your values

# ===========================================
# MongoDB
# ===========================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-secure-mongodb-password

# ===========================================
# Redis
# ===========================================
REDIS_PASSWORD=your-secure-redis-password

# ===========================================
# JWT Secrets
# ===========================================
JWT_SECRET=your-very-long-and-secure-jwt-secret-at-least-64-characters
JWT_REFRESH_SECRET=your-very-long-and-secure-refresh-secret-at-least-64-characters

# ===========================================
# URLs
# ===========================================
CLIENT_URL=https://your-domain.com
API_URL=https://api.your-domain.com

# ===========================================
# Email (SMTP)
# ===========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key