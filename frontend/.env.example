# ===========================================
# Frontend Environment Configuration
# ===========================================
# Copy this file to .env and update values

# ===========================================
# Application Settings
# ===========================================
VITE_APP_NAME="API Token Manager"
VITE_APP_VERSION="1.0.0"

# ===========================================
# API Configuration
# ===========================================
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# ===========================================
# Authentication
# ===========================================
VITE_TOKEN_KEY=auth_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_USER_KEY=user_data

# ===========================================
# Session Settings
# ===========================================
VITE_SESSION_TIMEOUT=3600000
VITE_REMEMBER_ME_DAYS=30

# ===========================================
# Feature Flags
# ===========================================
VITE_ENABLE_2FA=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true

# ===========================================
# External URLs
# ===========================================
VITE_DOCS_URL=https://docs.example.com
VITE_SUPPORT_URL=https://support.example.com

# ===========================================
# Analytics (Optional)
# ===========================================
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# ===========================================
# Default Settings
# ===========================================
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_LOCALE=en-US
VITE_DEFAULT_TIMEZONE=UTC
VITE_DATE_FORMAT=MM/DD/YYYY
VITE_CURRENCY_FORMAT=USD